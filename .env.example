# ==============================================================================
# IwaGranja — Plantilla completa de variables de entorno
# Copia este archivo a `.env.local` (desarrollo) o `.env` (Docker/producción)
# y completa los valores reales sin versionar secretos en Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de datos PostgreSQL y servidor web (Obligatorio)
# ------------------------------------------------------------------------------
# Si la contraseña contiene caracteres especiales (@, :, /, %, #), codifícala en URL.
DATABASE_URL=postgresql://TU_USUARIO:TU_CONTRASENA@127.0.0.1:5432/app_db
PORT=3000

# Solo para Docker Compose. En staging usa POSTGRES_DB, usuario y contraseña exclusivos.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app_db

# En Docker Compose: ejecuta `npm run db:bootstrap` automáticamente al iniciar
AUTO_MIGRATE_ON_BOOT=true

# ------------------------------------------------------------------------------
# 2. Administrador inicial y pruebas locales
# ------------------------------------------------------------------------------
# Opcional al ejecutar `npm run db:bootstrap` o `npm run db:create-admin` cuando la tabla `users` está vacía.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador Principal

# Requerido únicamente para `npm run db:seed -- --allow-destructive` en BD local descartable (mín. 12 caracteres).
DEMO_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 3. Asistente Gina — IA conversacional, Voz (STT) y Cámara/OCR (Visión)
# ------------------------------------------------------------------------------
# Proveedor OpenAI-compatible para chat/tool-calling de Gina (ej. DeepSeek, OpenAI, etc.)
ASSISTANT_AI_BASE_URL=https://api.deepseek.com/v1
ASSISTANT_AI_MODEL=deepseek-chat
ASSISTANT_AI_API_KEY=
ASSISTANT_AI_MAX_ITERATIONS=6
ASSISTANT_AI_TIMEOUT_MS=45000
ASSISTANT_AI_TEMPERATURE=0.2
# URL interna usada por Gina para consultar las APIs locales desde el servidor
ASSISTANT_INTERNAL_BASE_URL=http://127.0.0.1:3000

# Transcripción de notas de voz (STT) y lectura OCR de facturas/etiquetas (Visión).
# Si ASSISTANT_STT_API_KEY / ASSISTANT_VISION_API_KEY quedan vacías, el sistema usa
# OPENAI_API_KEY o GEMINI_API_KEY como respaldo según el proveedor configurado.
ASSISTANT_STT_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ASSISTANT_STT_MODEL=gemini-3.5-transcribe
ASSISTANT_STT_API_KEY=

ASSISTANT_VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
ASSISTANT_VISION_MODEL=gemini-3.5-flash-lite
ASSISTANT_VISION_API_KEY=

# Claves de respaldo opcionales por proveedor (si no se definen ASSISTANT_*_API_KEY)
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. Notificaciones por correo (SMTP) y alertas Telegram
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_EMAIL=
NOTIFY_EMAIL=
# Solo en entornos de prueba explícitos (`1` habilita pruebas SMTP en vivo)
SMTP_LIVE_TEST=0

# Canal Telegram (opcional): alertas, parte diario y agente bidireccional Gina.
# Sin token, la app degrada al texto compartible sin errores.
TELEGRAM_BOT_TOKEN=
# Usuario público del bot, sin @ (necesario para generar QR de vinculación).
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=
# Secreto del webhook bidireccional (header X-Telegram-Bot-Api-Secret-Token).
# Registrar el webhook con: node scripts/telegram-setup.mjs
TELEGRAM_WEBHOOK_SECRET=
# URL pública de la app para el webhook y los enlaces profundos (ej. https://app.iwage.co)
APP_URL=

# ------------------------------------------------------------------------------
# 5. Pasarela de pagos y suscripciones (Wompi Colombia)
# ------------------------------------------------------------------------------
# Usar únicamente claves sandbox para desarrollo. El checkout valida la política fiscal
# configurada por el servidor antes de crear una referencia de pago.
WOMPI_ENVIRONMENT=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_REDIRECT_URL=http://localhost:3000/configuracion/plan?payment=return

# Configuración financiera privada del cotizador Agregador (JSON server-only).
# No usar prefijo NEXT_PUBLIC_ ni incluir valores reales en control de versiones.
IWAGRANJA_PRICING_FINANCIAL_POLICY_JSON=

# ------------------------------------------------------------------------------
# 6. Telemetría IoT y analítica web (Opcional)
# ------------------------------------------------------------------------------
# Token Bearer/header para ingesta desde básculas o sensores externos (/api/operaciones/sensores)
SENSOR_WEBHOOK_TOKEN=
# Sincronización programada de fuentes externas. Definir un secreto aleatorio largo en despliegues.
CRON_SECRET=
EXTERNAL_SOURCES_SYNC_INTERVAL_MINUTES=60
SIPSA_SOAP_URL=http://appweb.dane.gov.co:9001/sipsaWS/SrvSipsaUpraBeanService

# Analítica de tráfico autoalojada o externa con Swetrix (opcional)
NEXT_PUBLIC_SWETRIX_PID=
NEXT_PUBLIC_SWETRIX_API_URL=

# ------------------------------------------------------------------------------
# 7. Identidad legal y comercial (/terminos, /retracto, /privacidad y pie legal)
# ------------------------------------------------------------------------------
LEGAL_RAZON_SOCIAL=
LEGAL_NIT=
LEGAL_TIPO_PERSONA=persona natural
LEGAL_CIUDAD=Ibagué, Tolima, Colombia
LEGAL_EMAIL=
LEGAL_WHATSAPP=
# Variable heredada; la política comercial actual muestra "IVA no cobrado".
LEGAL_IVA_NOTE=
