+'use strict';
+
+const TABLE_NAME = 'pagos';
+const COLUMN_NAME = 'wompi_transaction_id';
+const INDEX_NAME = 'pagos_wompi_transaction_id_unique_idx';
+
+const FIND_INDEX_SQL = `
+  SELECT
+    table_class.relname AS table_name,
+    index_data.indisunique AS is_unique,
+    (index_data.indisvalid AND index_data.indisready) AS is_usable,
+    index_data.indpred IS NULL AS is_unfiltered,
+    index_data.indexprs IS NULL AS has_no_expressions,
+    index_data.indnatts = 1 AS is_single_column,
+    pg_get_indexdef(index_data.indexrelid, 1, true) AS indexed_column
+  FROM pg_index AS index_data
+  JOIN pg_class AS table_class
+    ON table_class.oid = index_data.indrelid
+  JOIN pg_namespace AS table_schema
+    ON table_schema.oid = table_class.relnamespace
+  JOIN pg_class AS index_class
+    ON index_class.oid = index_data.indexrelid
+  JOIN pg_namespace AS index_schema
+    ON index_schema.oid = index_class.relnamespace
+  WHERE table_schema.nspname = current_schema()
+    AND index_schema.nspname = current_schema()
+    AND index_class.relname = ?
+`;
+
+function isExpectedIndex(index) {
+  return Boolean(
+    index &&
+      index.table_name === TABLE_NAME &&
+      index.is_unique === true &&
+      index.is_usable === true &&
+      index.is_unfiltered === true &&
+      index.has_no_expressions === true &&
+      index.is_single_column === true &&
+      index.indexed_column === COLUMN_NAME,
+  );
+}
+
+async function findIndex(knex) {
+  const result = await knex.raw(FIND_INDEX_SQL, [INDEX_NAME]);
+  return result.rows[0] ?? null;
+}
+
+module.exports = {
+  async up(knex) {
+    if (!(await knex.schema.hasTable(TABLE_NAME))) return;
+    if (!(await knex.schema.hasColumn(TABLE_NAME, COLUMN_NAME))) return;
+
+    const existingIndex = await findIndex(knex);
+    if (existingIndex) {
+      if (!isExpectedIndex(existingIndex)) {
+        throw new Error(
+          'No se puede garantizar la unicidad de wompi_transaction_id: el nombre esperado ya pertenece a un índice incompatible. ' +
+            'Revísalo antes de reiniciar Reservas; no se modificaron filas.',
+        );
+      }
+      return;
+    }
+
+    try {
+      await knex.raw(
+        `CREATE UNIQUE INDEX IF NOT EXISTS "${INDEX_NAME}" ON "${TABLE_NAME}" ("${COLUMN_NAME}")`,
+      );
+    } catch (error) {
+      if (error?.code !== '23505') throw error;
+      // PostgreSQL may include the conflicting value in the original error detail.
+      throw new Error('Existen IDs Wompi repetidos. Concílialos antes de crear el índice único; no se modificaron filas.');
+    }
+
+    const createdIndex = await findIndex(knex);
+    if (!isExpectedIndex(createdIndex)) {
+      throw new Error(
+        'No se pudo verificar el índice único de wompi_transaction_id después de crearlo. ' +
+          'No se modificaron filas.',
+      );
+    }
+  },
+
+  async down() {},
+};
