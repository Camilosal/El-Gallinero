{
  "$meta": {
    "system": "Iwagé · Agroeditorial Ilustrado",
    "version": "0.1.0",
    "status": "propuesta-base",
    "sourceOfTruth": true,
    "note": "Modificar aquí; regenerar CSS con python3 scripts/build_tokens.py"
  },
  "color": {
    "forest": "#315245",
    "forest-dark": "#26463A",
    "paper": "#F3EDE0",
    "paper-light": "#FCFBF7",
    "white": "#FFFFFF",
    "ochre": "#B17A45",
    "terracotta": "#C76E4C",
    "graphite": "#253238",
    "muted": "#536760",
    "border": "#C9CEC3",
    "sage": "#E5EBD8",
    "success": "#286B4A",
    "warning": "#9A5C1A",
    "danger": "#A83F32",
    "info": "#2D637B",
    "outline-soft": "#8B9A86",
    "ink-strong": "#121D15",
    "field-border": "#798A80"
  },
  "semantic": {
    "bg-page": "{color.paper}",
    "bg-surface": "{color.white}",
    "bg-subtle": "{color.paper-light}",
    "bg-feature": "{color.sage}",
    "text-primary": "{color.graphite}",
    "text-secondary": "{color.muted}",
    "text-inverse": "{color.white}",
    "border-default": "{color.border}",
    "border-strong": "{color.forest}",
    "action-primary": "{color.forest}",
    "action-primary-hover": "{color.forest-dark}",
    "action-primary-text": "{color.white}",
    "action-secondary": "{color.paper-light}",
    "action-secondary-text": "{color.forest}",
    "action-secondary-border": "{color.forest}",
    "accent-ochre": "{color.ochre}",
    "accent-terracotta": "{color.terracotta}",
    "status-success": "{color.success}",
    "status-warning": "{color.warning}",
    "status-danger": "{color.danger}",
    "status-info": "{color.info}",
    "focus-ring": "{color.info}",
    "border-input": "{color.field-border}",
    "border-illustration": "{color.outline-soft}",
    "text-on-accent": "{color.ink-strong}"
  },
  "font": {
    "display": "'Fraunces', Georgia, 'Times New Roman', serif",
    "body": "'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
  },
  "type": {
    "display": "clamp(2.65rem, 5vw, 4.5rem)",
    "h1": "clamp(2rem, 3.5vw, 3rem)",
    "h2": "clamp(1.5rem, 2.3vw, 2rem)",
    "h3": "1.25rem",
    "body": "1rem",
    "small": "0.875rem",
    "caption": "0.75rem"
  },
  "leading": {
    "display": "1.05",
    "heading": "1.2",
    "body": "1.55",
    "small": "1.45"
  },
  "space": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px",
    "12": "48px",
    "16": "64px",
    "24": "96px"
  },
  "radius": {
    "xs": "4px",
    "sm": "6px",
    "control": "10px",
    "card": "16px",
    "pill": "999px"
  },
  "size": {
    "touch-min": "48px",
    "container": "1160px",
    "reading": "720px"
  },
  "shadow": {
    "card": "0 3px 16px rgba(37, 50, 56, 0.06)",
    "popover": "0 12px 30px rgba(37, 50, 56, 0.12)"
  },
  "motion": {
    "fast": "120ms",
    "normal": "180ms",
    "slow": "250ms"
  }
}
